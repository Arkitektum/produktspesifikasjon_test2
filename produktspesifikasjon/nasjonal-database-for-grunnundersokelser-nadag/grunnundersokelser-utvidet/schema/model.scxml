 <sc:packages>
  <sc:Package>
   <sc:name>grunnundersokelser-utvidet</sc:name>
   <sc:id>P1</sc:id>
   <sc:stereotypes>
    <sc:Stereotype>application schema</sc:Stereotype>
   </sc:stereotypes>
   <sc:taggedValues>
    <sc:TaggedValue>
